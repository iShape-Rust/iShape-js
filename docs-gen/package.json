{
  "name": "ishape-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build:i-shape": "bash scripts/update-i-shape.sh",
    "build:overlay-editor": "bash scripts/update-overlay-editor.sh",
    "build:ts": "tsc --project tsconfig.json",
    "watch:ts": "tsc --project tsconfig.json --watch",
    "build": "npm run build:ts && mdbook build",
    "serve": "npm run build:ts && mdbook serve --open"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
